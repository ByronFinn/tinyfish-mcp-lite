{
  "name": "tinyfish-mcp-lite",
  "version": "0.1.0",
  "description": "Fork of @tiny-fish/mcp exposing only the free TinyFish tools (search, fetch_content) \u2014 local reverse proxy to agent.tinyfish.ai/mcp",
  "mcpName": "io.github.ByronFinn/tinyfish-mcp-lite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByronFinn/tinyfish-mcp-lite.git"
  },
  "homepage": "https://github.com/ByronFinn/tinyfish-mcp-lite#readme",
  "bugs": {
    "url": "https://github.com/ByronFinn/tinyfish-mcp-lite/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tinyfish",
    "web-automation",
    "browser-automation",
    "proxy"
  ],
  "author": "ByronFinn (fork of TinyFish's tinyfish-mcp-server, MIT)",
  "type": "module",
  "license": "MIT",
  "allowScripts": {
    "tinyfish-mcp-lite": true,
    "esbuild": true,
    "fsevents": true
  },
  "bin": {
    "tinyfish-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "type-check": "tsc --noEmit --project tsconfig.all.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "@vitest/mocker": "^4.1.11",
    "fast-uri": "^3.1.8",
    "nanoid": "^3.3.19",
    "qs": "^6.16.0"
  }
}
